# Build output
/target
**/*.rs.bk
Cargo.lock.bak
# Release archives: scripts/release.sh and scripts/pluton-build.sh write here.
/dist/

# Local tooling
__pycache__/
.vscode/
.idea/
# Agent worktrees, which are checkouts of this repository inside it.
.claude/
*.swp
*.swo
.DS_Store
Thumbs.db

# Never commit wallets, keys, node databases or local env files
*.wallet
*.keys
*.env
.env*
/DB/
/data/
/fuzz/target
/fuzz/artifacts

# Chain state, databases and logs a node or an import leaves in the checkout.
# `--data-dir ./wrkz-rust`, `--data-dir ./wrkz-sync0`, `--state ./state` and a
# copied C++ `data-20260909/DB` are the shapes these take; .dockerignore keeps
# the same list out of `docker build`. Anchored, so `/wrkz-*/` cannot match the
# crates.
/data-*/
/wrkz-*/
/state/
/state-full/
/ipc-*
*.db
*.log

# Kept local: not part of the published repository.
/docs/

# From GitHub's Rust template
debug
target
*.pdb
**/mutants.out*/

# The spec/05 test-vector wallets the tests read (never funded)
!/crates/wrkz-wallet/tests/fixtures/spec05-*.wallet
